% vim: set ft=tex
% Industry CV: a dense one-pager that keeps the academic CV's identity (the
% Baskerville faces, the grey ramp, the left band, dot-underlined links) but
% turns the band into a content sidebar and the body into achievement bullets.
% The sidebar is an absolutely positioned overlay (like the academic CV's
% profile photo), so only the main column drives page breaking.
\documentclass[10pt]{article}

\usepackage[no-math]{fontspec}
\usepackage[a4paper,left=5.8cm,right=1.1cm,top=1.2cm,bottom=1.2cm]{geometry}
\usepackage{tikz}
\usepackage[hidelinks]{hyperref}
\usepackage{xcolor}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{everypage}
\usepackage[normalem]{ulem}

\setmainfont{Baskerville10Pro}[
  Path = fonts/Baskerville 10 Pro/,
  Ligatures = TeX,
  Extension = .otf,  % chktex 26
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic,
  FontFace = {sb}{n}{*-Medium},
  FontFace = {sb}{it}{*-MediumItalic},
]
\newfontfamily\largefont{Baskerville120Pro}[
  Path = fonts/Baskerville 120 Pro/,
  Extension = .otf,  % chktex 26
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic,
  FontFace = {sb}{n}{*Medium},
  FontFace = {sb}{it}{*Medium-Italic},
]
\setmonofont{iosevka-fixed-curly-slab}[
  Path = fonts/Iosevka/,
  Extension = .ttf,  % chktex 26
  UprightFont = *-regular,
  BoldFont = *-bold,
  ItalicFont = *-italic,
  BoldItalicFont = *-bolditalic,
  Scale = MatchLowercase,
]
\DeclareRobustCommand{\sbseries}{\fontseries{sb}\selectfont}
\DeclareTextFontCommand{\textsb}{\sbseries}

\hypersetup{pdftitle={Jan Hermann CV},pdfauthor={Jan Hermann}}

\pagestyle{empty}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\emergencystretch=1em

\titleformat{\section}{\largefont\fontsize{13pt}{15pt}\selectfont\color{black!65}}{\thesection}{}{}
\titlespacing*{\section}{0pt}{1.1em}{0.4em}

\setlist[itemize]{nosep,leftmargin=1em,labelsep=0.45em,topsep=1.5pt,itemsep=1.5pt,
  label=\textcolor{black!40}{$\bullet$}}

\setlength{\ULdepth}{1.8pt}

\makeatletter
\def\SmallDotuline#1{\bgroup%
  \UL@setULdepth%
  \markoverwith{\begingroup
     \advance\ULdepth0.08ex
     \lower\ULdepth\hbox{\scalebox{0.4}{.}\kern#1}%
     \endgroup}%
  \ULon}
\makeatother

\urlstyle{same}
\newcommand{\udot}[1]{\SmallDotuline{0pt}{#1}}
\let\oldurl\url%
\renewcommand{\url}[1]{\udot{\oldurl{#1}}}
\let\oldhref\href%
\renewcommand{\href}[2]{\oldhref{#1}{\udot{#2}}}

% The band is an every-page hook (not a one-off) so that an overflow second
% page stays styled.
\AddEverypageHook{
\begin{tikzpicture}[overlay,remember picture]
     \draw [draw=none, fill=black!30]
    	(current page.north west)
    	rectangle
    	([xshift=5.2cm] current page.south west);
\end{tikzpicture}
}

\renewcommand{\strong}[1]{\textsb{#1}}

\newcommand{\sidesection}[1]{\par\vspace{0.85em}{\largefont\fontsize{11pt}{13pt}\selectfont\color{black!65}#1}\par\vspace{0.3em}}

\hyphenation{Schrö-ding-er}

\begin{document}

\noindent\begin{tikzpicture}[overlay,remember picture]
\node[anchor=north west, inner sep=0] at ([xshift=0.5cm, yshift=-1.3cm] current page.north west) {%
\begin{minipage}[t]{4.2cm}
\raggedright\setlength{\parskip}{1.5pt}\footnotesize
{\sbseries Berlin, Germany}\par
<+ for key in industry.contact_keys +>
\href{<< contact[key][1] >><< contact[key][0] >>}{<< contact[key][0] >>}\par
<+ endfor +>
\href{<< contact["Google Scholar"][1] >><< contact["Google Scholar"][0] >>}{Google Scholar profile}\par

\sidesection{Skills}
<+ for s in industry.skills +>
{\sbseries << s.area >>}\par
{\color{black!60}<< s["items"] >>}\par\vspace{2pt}
<+ endfor +>

\sidesection{Open source}
<+ for entry in industry.software +>
<+ set item = software|selectattr("name", "equalto", entry.name)|first +>
{\sbseries\href{<< item.url >>}{<< item.name >>}} $\cdot$ << item.role >><+ if item.stars +> $\cdot$ << item.stars >> stars<+ endif +>\par
{\color{black!60}<< entry.blurb >>}\par\vspace{2pt}
<+ endfor +>
{\color{black!60}<< industry.software_note >>}\par

\sidesection{Education}
<+ for deg in industry.education +>
{\sbseries << deg.title >>}\par
{\color{black!60}<< deg.detail >>}\par\vspace{2pt}
<+ endfor +>

\sidesection{Mentoring \& service}
<+ for item in industry.service +>
<< item >>\par\vspace{2pt}
<+ endfor +>

\sidesection{Awards}
<+ for item in industry.awards +>
{\color{black!60}<< item.year >>} $\cdot$ << item.text >>\par\vspace{2pt}
<+ endfor +>

\vspace{1em}
{\scriptsize\color{black!60}(\href{https://hrmnn.net/cv-industry.pdf}{generated} on <+ if settings.generated +>\href{<< settings.generated >>}{\today}<+ else +>\today<+ endif +>; citation and star counts are live)}\par
\end{minipage}};
\end{tikzpicture}%
{\sbseries\largefont\fontsize{26pt}{28pt}\selectfont
 \textcolor{black!40}{Jan} \textcolor{black!65}{Hermann}}\par
\vspace{0.4em}
{\itshape\color{black!60}<< industry.tagline >>}\par
\vspace{0.55em}
<+ set ncites = custom_data.scholar_citations.value.values()|sum +>
<+ set nstars = software|selectattr("stars", "defined")|map(attribute="stars")|sum +>
{\small\color{black!60}\textsb{<< references|length >>}~publications
 ~$\cdot$~\textsb{<< "{:,}".format(ncites // 100 * 100) >>+}~citations
 ~$\cdot$~\textsb{<< nstars // 50 * 50 >>+}~GitHub stars}\par
\vspace{0.7em}
{\small << industry.summary >>}\par

\section{Experience}
<+ for job in industry.experience +>
{\small\textsb{<< job.role >>}\hfill{\footnotesize\color{black!60}<< job.date|dateformat >>}\\
\emph{<< job.company >><+ if job.location +>, << job.location >><+ endif +>}}\par
\vspace{0.15em}
\begin{itemize}\small
<+ for b in job.bullets +>
\item << b >>
<+ endfor +>
\end{itemize}
<+ if not loop.last +>\vspace{0.55em}<+ endif +>
<+ endfor +>

\section{Selected publications}
{\footnotesize
<+ for key in industry.selected_pubs +>
<+ set item = refs_by_id[key] +>
<+ set title, authors, ref = item|reftomd +>
\hangindent=1.2em\hangafter=1 << title >>~$\cdot$ << authors >>~$\cdot$ << ref >><+ if item.cited_by +>\hfill\mbox{\hspace{0.6em}\color{black!60}<< item.cited_by >>}<+ endif +>\par\vspace{1.5pt}
<+ endfor +>
\vspace{0.3em}
{\color{black!60}Right column: Google Scholar citations. Full academic CV with all << references|length >> works: \href{https://hrmnn.net/cv.pdf}{hrmnn.net/cv.pdf}.}\par
}

\end{document}
