% vim: set ft=tex
<# Industry CV: a two-column one-pager keeping the academic CV's identity (the
   Baskerville faces, the grey ramp, the grey band, dot-underlined links) with
   the band turned into a content sidebar.

   The sidebar sits on the RIGHT. Column-aware extractors read the left column
   first by geometry, whatever order the content stream is written in, so a left
   sidebar always precedes the name — which is what decides whether a candidate
   record gets created at all. #>
<+ set accent = "347AB7" +>
\documentclass[10pt]{article}

\usepackage[no-math]{fontspec}

% Same 14.1cm measure for the main column as a left sidebar would give.
\usepackage[a4paper,left=1.1cm,right=6.4cm,top=1.2cm,bottom=1.2cm]{geometry}
\usepackage{tikz}
\usepackage{everypage}

\usepackage[hidelinks]{hyperref}
\usepackage{xcolor}
\usepackage{graphicx}  % \scalebox, for the dotted-underline rule below
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage[normalem]{ulem}

\setmainfont{Baskerville10Pro}[
  Path = fonts/Baskerville 10 Pro/,
  Ligatures = TeX,
  Extension = .otf,  % chktex 26
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic,
  FontFace = {sb}{n}{*-Medium},
  FontFace = {sb}{it}{*-MediumItalic},
]
\newfontfamily\largefont{Baskerville120Pro}[
  Path = fonts/Baskerville 120 Pro/,
  Extension = .otf,  % chktex 26
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic,
  FontFace = {sb}{n}{*Medium},
  FontFace = {sb}{it}{*Medium-Italic},
]
\setmonofont{iosevka-fixed-curly-slab}[
  Path = fonts/Iosevka/,
  Extension = .ttf,  % chktex 26
  UprightFont = *-regular,
  BoldFont = *-bold,
  ItalicFont = *-italic,
  BoldItalicFont = *-bolditalic,
  Scale = MatchLowercase,
]
\DeclareRobustCommand{\sbseries}{\fontseries{sb}\selectfont}
\DeclareTextFontCommand{\textsb}{\sbseries}

% Baskerville 120 Pro ships no Light -- Regular is the lightest face in the
% family, and the name already uses it. To take a word a step below that, draw
% the glyphs in fill-and-stroke mode (2 Tr) with the stroke in the page colour,
% which trims the outline inward from its edge. 0.25pt at 26pt sheds about a
% sixth of the ink; text extraction is untouched, since the glyphs stay real
% text. Two things this leans on:
%
%   - the stroke colour has to be set *after* \color. xcolor sets fill and
%     stroke together, so an override placed before it is silently replaced,
%     leaving the stroke at the fill colour -- which thickens the glyphs into a
%     fake bold rather than thinning them.
%   - white stroke assumes white behind it. True in the main column; over the
%     grey band it would need the band's colour instead.
\newcommand{\lightface}[1]{{\color{black!40}%
  \special{pdf:literal direct 2 Tr 0.25 w 1 1 1 RG}#1%
  \special{pdf:literal direct 0 Tr}}}

% One restrained accent, the link blue the website already uses, so the CV and
% the site read as the same hand. One is the ceiling.
\definecolor{accent}{HTML}{<< accent >>}

\hypersetup{pdftitle={Jan Hermann CV},pdfauthor={Jan Hermann}}

\pagestyle{empty}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\emergencystretch=1em

% Main-column headings outrank the sidebar's: larger, accented, ruled.
\titleformat{\section}{\largefont\fontsize{13pt}{15pt}\selectfont\color{accent}}{\thesection}{}{}[{\color{accent!25}\titlerule[0.5pt]}]
\titlespacing*{\section}{0pt}{0.8em}{0.4em}

\setlist[itemize]{nosep,leftmargin=1em,labelsep=0.45em,topsep=1.5pt,itemsep=1.5pt,
  label=\textcolor{black!40}{$\bullet$}}

\setlength{\ULdepth}{1.8pt}

\makeatletter
\def\SmallDotuline#1{\bgroup%
  \UL@setULdepth%
  \markoverwith{\begingroup
     \advance\ULdepth0.08ex
     \lower\ULdepth\hbox{\scalebox{0.4}{.}\kern#1}%
     \endgroup}%
  \ULon}
\makeatother

\urlstyle{same}
\newcommand{\udot}[1]{\SmallDotuline{0pt}{#1}}
\let\oldurl\url%
\renewcommand{\url}[1]{\udot{\oldurl{#1}}}
\let\oldhref\href%
\renewcommand{\href}[2]{\oldhref{#1}{\udot{#2}}}

\renewcommand{\strong}[1]{\textsb{#1}}

% The band is an every-page hook (not a one-off) so that an overflow second
% page stays styled.
\AddEverypageHook{
\begin{tikzpicture}[overlay,remember picture]
     \draw [draw=none, fill=black!30]
    	(current page.north east)
    	rectangle
    	([xshift=-5.4cm] current page.south east);
\end{tikzpicture}
}
\newcommand{\sidesection}[1]{\par\vspace{0.85em}{\largefont\fontsize{11pt}{13pt}\selectfont\color{black!65}#1}\par\vspace{0.3em}}

\hyphenation{Schrö-ding-er}

<# Contact entries render their own destination as the visible text, so the
   address survives a parser that strips link annotations. Google Scholar is the
   one exception: its URL is a bare user id, useless as visible text. #>
<+ macro contact_line() +>
<+- set parts = [] +>
<+- for key in industry.contact_keys +>
<+- set val = contact[key][0] +>
<+- set pre = contact[key][1] +>
<+- set disp = val if pre.startswith("mailto:") else (pre|replace("https://", "")|replace("www.", "")) ~ val +>
<+- set _ = parts.append("\\href{" ~ pre ~ val ~ "}{" ~ disp ~ "}") +>
<+- endfor +>
<+- set gs = contact["Google Scholar"] +>
<+- set _ = parts.append("\\href{" ~ gs[1] ~ gs[0] ~ "}{Google Scholar}") +>
<< parts|join("~$\\cdot$~") >>
<+- endmacro +>

<# Experience is the CV's own `employment`, flattened. A position appears here
   only if it carries an `industry` block, which is also where its bullets live —
   so the undergraduate assistantship drops out without needing a flag. The
   company line is composed from the same dept and institution the academic CV
   prints separately. #>
<+ macro experience_block() +>
<+ set jobs = [] +>
<+ for e in employment +>
<+ for p in e.positions if p.industry +>
<+ set _ = jobs.append((p, e)) +>
<+ endfor +>
<+ endfor +>
<+ for job, org in jobs +>
{\small\textsb{<< job.role >>}\hfill{\footnotesize\color{black!60}<< job.date|dateformat >>}\\
% Broadest first: employer, then the unit inside it, then the city set off by a
% dash so it does not read as one more level of org chart. The dept carries the
% markdown link the academic CV shows, so strip the dotted underline here: the
% destination survives, the company line stays clean.
\renewcommand{\udot}[1]{#1}%
\emph{<< org.institution >>, << job.dept >><+ if org.location +> – << org.location >><+ endif +>}}\par
\vspace{0.15em}
\begin{itemize}\small
<+ for b in job.industry.bullets +>
\item << b >>
<+ endfor +>
\end{itemize}
<+ if not loop.last +>\vspace{0.4em}<+ endif +>
<+ endfor +>
<+ endmacro +>

\begin{document}

<#- ============================ MAIN COLUMN ============================ -#>
<# The title takes the pale grey "Jan" carries, and \lightface thins it a step
   below the family's lightest face — so it recedes by both colour and weight
   without a second type size. `\ ` keeps the period from picking up sentence
   spacing. #>
{\largefont\fontsize{26pt}{28pt}\selectfont
 \lightface{Dr.}\ \textsb{\textcolor{black!40}{Jan} \textcolor{black!65}{Hermann}}}\par
\vspace{0.3em}
{\itshape\color{black!60}<< industry.tagline >>}\par
\vspace{0.4em}
<+ set ncites = custom_data.scholar_citations.value.values()|sum +>
<+ set nstars = software|selectattr("stars", "defined")|map(attribute="stars")|sum +>
<# Adoption before citations: stars and production-code adoption are legible to
   an industry screener and a research reviewer alike. No h-index anywhere. #>
{\small\color{black!60}\textsb{<< nstars // 50 * 50 >>+}~GitHub stars
 ~$\cdot$~shipped in \textsb{<< industry.production_codes|length >>}~production codes
 ~$\cdot$~\textsb{<< references|length >>}~publications
 ~$\cdot$~\textsb{<< "{:,}".format(ncites // 100 * 100) >>+}~citations}\par
\vspace{0.3em}
% Colour-only links: five dot-underlined URLs in a row made the busiest line on
% the page out of the one a reader should scan fastest.
{\footnotesize\renewcommand{\udot}[1]{\textcolor{accent}{#1}}%
 Berlin $\cdot$ << contact_line() >>}\par
\vspace{0.55em}
{\small << industry.summary >>}\par

<#- ========================= SIDEBAR ========================= -#>

<# Placed here, after the summary, rather than at the end of the document. An
   overlay tikzpicture occupies no space but is still a box on the vertical
   list, so at the end of a nearly-full page TeX breaks the page to place it and
   the whole sidebar lands on page 2. Mid-document it cannot. Sitting after the
   summary also keeps stream-order extraction clean: name and contact still come
   first, and no sidebar text precedes the summary paragraph in either
   extraction mode. #>
\begin{tikzpicture}[overlay,remember picture]
% Pointer to the long form, sitting just above the sidebar as that column's
% masthead. It takes the sidebar's own width and right edge, so the label and
% the URL break across two lines rather than overhanging the band into the main
% column. The URL is its own visible text like the contact line: the address
% survives a parser that strips link annotations, and a printed copy stays
% actionable. \scriptsize pairs it with the provenance note at the band's foot,
% and is declared as a node option so the two lines sit on its own leading —
% see the note at the band's foot for why the body is the wrong place for it.
%
% Kept off the band's top strip, which is level with the name: poppler reads
% that strip before the header beside it, so text there displaces the contact
% details down the extraction, and two lines up there pushed the contact past
% the window check_cv_parsing.py allows. Down here it trails the contact line
% instead, which is what buys the second line.
\node[anchor=south east, inner sep=0, text width=3.9cm, align=right, font=\scriptsize] at ([xshift=-0.7cm, yshift=-4.6cm] current page.north east)
  {\color{black!60}Academic CV:\\
   \renewcommand{\udot}[1]{\textcolor{accent}{#1}}%
   \href{https://hrmnn.net/cv-academic.pdf}{hrmnn.net/cv-academic.pdf}};
% Sidebar starts below the summary, clear of the name/contact header. While it
% began higher, its first block shared a vertical band with the name and poppler
% spliced it between the name and the tagline; down here there is a clean
% two-column region it reads left-then-right.
\node[anchor=north west, inner sep=0] at ([xshift=-4.6cm, yshift=-4.9cm] current page.north east) {%
\begin{minipage}[t]{3.9cm}
\raggedright\setlength{\parskip}{1.5pt}\footnotesize
\sidesection{Skills}
<+ for s in industry.skills +>
{\sbseries << s.area >>}\par
{\color{black!60}<< s["items"] >>}\par\vspace{2pt}
<+ endfor +>

\sidesection{Open source}
<+ for name in industry.software +>
<+ set item = software|selectattr("name", "equalto", name)|first +>
{\sbseries\href{<< item.url >>}{<< item.name >>}} $\cdot$ << item.role >><+ if item.stars +> $\cdot$ << item.stars >> stars<+ endif +>\par
{\color{black!60}<< item.blurb >>}\par\vspace{2pt}
<+ endfor +>

\sidesection{Education}
<# Derived from the CV's own `education` block rather than restated beside it.
   Degrees taken at one university at the same level in the same year are merged
   onto a line (the two B.S. degrees), which is the only way the sidebar's
   presentation differs from the source. #>
<+ for school in education +>
<+ set groups = {} +>
<+ for d in school.degrees +>
<+ set _ = groups.setdefault(d.degree ~ " " ~ d.date.split()[-1], []).append(d) +>
<+ endfor +>
<+ for _, ds in groups.items() +>
{\sbseries << ds[0].degree >> << ds|map(attribute="field")|join(" & ") >>}\par
{\color{black!60}<< school.university >><+ if school.location +>, << school.location >><+ endif +>, << ds[0].date.split()[-1] >><+ if ds[0].note +> (\emph{<< ds[0].note >>})<+ endif +>}\par\vspace{2pt}
<+ endfor +>
<+ endfor +>

\sidesection{Awards}
<# Derived from the CV's own `awards`, so the wording lives in one place. #>
<+ for item in awards +>
{\color{black!60}<< item.date.split()[-1] >>} $\cdot$ << item.title >><+ if item.institution +>, << item.institution >><+ endif +><+ if item.note +> \emph{(<< item.note >>)}<+ endif +>\par\vspace{2pt}
<+ endfor +>

\sidesection{Ships inside}
{\color{black!60}<< industry.production_codes[:-1]|join(", ") >> \& << industry.production_codes[-1] >>}\par

% Plain text, no dotted links: the provenance note was carrying heavier link
% styling than its importance justifies.
\end{minipage}};
% Pinned to the foot of the band rather than left floating below the sidebar's
% last block, which ends well above the main column.
%
% Size declared as a node option, not in the body: TikZ sets the text box up
% before the body runs, so a \scriptsize inside it shrinks the glyphs while the
% lines stay on \normalsize's 12pt leading. As an option it lands in time and
% the note wraps on its own leading, like the sidebar blocks above it.
\node[anchor=south west, inner sep=0, text width=3.9cm, font=\scriptsize] at ([xshift=-4.6cm, yshift=1.2cm] current page.south east)
  {\color{black!60}(generated on \today; citation and star counts are live)};
\end{tikzpicture}%

\section{Experience}
<< experience_block() >>

\section{Selected publications}
{\footnotesize
% Colour-only links here: the dotted underline on every journal name, volume
% and arXiv id turned the block into visual noise.
\renewcommand{\udot}[1]{\textcolor{accent}{#1}}
{\raggedleft\scriptsize\color{black!45}citations\par}
\vspace{-0.15em}
<+ for id, entry in keypubs.items() if entry.authors is defined +>
<+ set item = refs_by_id[id] +>
<+ set title, authors, ref = item|reftomd +>
% Citation count sits in its own fixed-width gutter rather than after an
% \hfill, so a title that fills the measure cannot orphan the number onto the
% next line. Same idea as the academic CV's trailing table column.
\noindent\parbox[t]{\dimexpr\linewidth-2.6em\relax}{\hangindent=1.2em\hangafter=1 << entry.title|default(title, true) >>~$\cdot$ << entry.authors >>~$\cdot$ << ref >><+ if entry.credit +>~$\cdot$ \mbox{\emph{<< entry.credit >>}}<+ endif +>}\hfill\parbox[t]{2em}{\raggedleft\color{black!60}<+ if item.cited_by +><< item.cited_by >><+ endif +>}\par\vspace{1pt}
<+ endfor +>
\vspace{0.2em}
{\color{black!60}All << references|length >> works: \href{https://hrmnn.net/cv-academic.pdf}{hrmnn.net/cv-academic.pdf}}\par
}

<# Service sits in the main column, not the sidebar: mentoring and peer review
   are substantive for a research-leadership read, and the sidebar has no room
   for them once it starts below the header. Items are emitted one at a time so
   each passes through the markdown finalizer individually — joining them on a
   separator containing a backslash would make the whole string look like raw
   TeX and skip conversion. #>
\section{Mentoring and service}
{\footnotesize <+ for item in industry.service +><+ if not loop.first +>~$\cdot$~<+ endif +><< item >><+ endfor +>}\par

\end{document}
